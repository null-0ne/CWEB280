<h1>Registration Form</h1>

  {{#if errors}}
    <ul style="color: red;">
      {{#each errors}}
        <li>{{this.msg}}</li>{{/each}}
    </ul>{{/if}}

  <form action="/register" method="POST">
    <label>Email:</label>
    <input type="text" name="email" value="{{oldInput.email}}" required><br><br>

    <label>Password:</label>
    <input type="password" name="password" required><br><br>

    <label>Age:</label>
    <input type="number" name="age" value="{{oldInput.age}}" required><br><br>

    <button type="submit">Register</button>
  </form>
</body>
</html>