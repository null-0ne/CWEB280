<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>HTMX Node.js Example</title>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  </head>
  <body>
    <h1>HTMX with Express</h1>

    <button hx-get="/hello" hx-target="#result" hx-swap="innerHTML">
      Say Hello
    </button>

    <form hx-post="/save-data" hx-target="#result" hx-swap="innerHTML">
      <input type="text" name="name" placeholder="Enter your name" required />
      <button type="submit">Send</button>
    </form>

    <div id="result"></div>
  </body>
</html>